+
+uint64_t
+NrMacSchedulerNs3::GetTotalDlBufferBytes() const
+{
+    uint64_t totalBytes = 0;
+    for (const auto& entry : m_ueMap)
+    {
+        totalBytes += entry.second->GetTotalDlBuffer();
+    }
+    return totalBytes;
+}
+
+NrMacSchedulerNs3::DlObservationStats
+NrMacSchedulerNs3::GetDlObservationStats() const
+{
+    DlObservationStats stats;
+    std::vector<double> validCqis;
+    double mcsSum = 0.0;
+
+    for (const auto& entry : m_ueMap)
+    {
+        const auto& ue = entry.second;
+        const uint32_t ueBufferBytes = ue->GetTotalDlBuffer();
+        stats.totalBufferBytes += ueBufferBytes;
+        stats.maxUeBufferBytes = std::max(stats.maxUeBufferBytes, ueBufferBytes);
+        mcsSum += static_cast<double>(ue->GetDlMcs());
+        stats.ueCount++;
+
+        // A non-zero timer identifies CQI from actual CSI feedback instead of
+        // the scheduler's initial/fallback value.
+        if (ue->m_dlCqi.m_timer > 0)
+        {
+            validCqis.push_back(static_cast<double>(ue->m_dlCqi.m_wbCqi));
+        }
+    }
+
+    if (stats.ueCount > 0)
+    {
+        stats.meanMcs = mcsSum / static_cast<double>(stats.ueCount);
+    }
+    if (!validCqis.empty())
+    {
+        std::sort(validCqis.begin(), validCqis.end());
+        const std::size_t p10Index = static_cast<std::size_t>(
+            std::floor(0.10 * static_cast<double>(validCqis.size() - 1)));
+        stats.validCqiCount = validCqis.size();
+        stats.minCqi = validCqis.front();
+        stats.p10Cqi = validCqis.at(p10Index);
+        stats.meanCqi = std::accumulate(validCqis.begin(), validCqis.end(), 0.0) /
+                        static_cast<double>(validCqis.size());
+    }
+
+    return stats;
+}
