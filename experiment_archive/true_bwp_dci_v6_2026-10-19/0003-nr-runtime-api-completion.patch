+NrGnbPowerState
+NrGnbEnergyModel::SelectSleepState(Time idleDuration) const
+{
+    NS_ABORT_MSG_IF(idleDuration < Seconds(0), "Idle duration cannot be negative");
+
+    NrGnbPowerState best = NrGnbPowerState::MicroSleep;
+    double bestEnergyJ =
+        ToWatts(GetRelativePower(best)) * idleDuration.GetSeconds();
+    for (const auto candidate : {NrGnbPowerState::LightSleep, NrGnbPowerState::DeepSleep})
+    {
+        if (idleDuration < GetTransitionTime(candidate))
+        {
+            continue;
+        }
+        const double energyJ = ToWatts(GetRelativePower(candidate)) * idleDuration.GetSeconds() +
+                               GetTransitionEnergyJ(candidate);
+        if (energyJ < bestEnergyJ)
+        {
+            best = candidate;
+            bestEnergyJ = energyJ;
+        }
+    }
+    return best;
+}
