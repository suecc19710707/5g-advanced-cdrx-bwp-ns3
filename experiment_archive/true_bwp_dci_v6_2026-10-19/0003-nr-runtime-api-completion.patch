+/**
+ * @brief DRX start offset controls eligibility and energy on one timeline.
+ */
+class NrUeDrxModelOffsetTestCase : public TestCase
+{
+  public:
+    NrUeDrxModelOffsetTestCase()
+        : TestCase("NrUeDrxModel start offset shifts scheduling and energy together")
+    {
+    }
+
+  private:
+    void DoRun() override;
+};
+
+void
+NrUeDrxModelOffsetTestCase::DoRun()
+{
+    Ptr<NrUeEnergyModel> ue = CreateObject<NrUeEnergyModel>();
+    Ptr<NrUeDrxModel> drx = CreateObject<NrUeDrxModel>();
+    drx->SetAttribute("LongCycle", TimeValue(MilliSeconds(40)));
+    drx->SetAttribute("OnDuration", TimeValue(MilliSeconds(10)));
+    drx->SetAttribute("StartOffset", TimeValue(MilliSeconds(20)));
+    drx->SetEnergyModel(ue);
+    drx->Start(Simulator::Now() + drx->GetStartOffset());
+
+    NS_TEST_ASSERT_MSG_EQ(drx->IsActiveAt(MilliSeconds(10)),
+                          false,
+                          "UE must be asleep before its first offset onDuration");
+    NS_TEST_ASSERT_MSG_EQ(drx->IsActiveAt(MilliSeconds(25)),
+                          true,
+                          "UE must be active inside its offset onDuration");
+    NS_TEST_ASSERT_MSG_EQ(drx->IsActiveAt(MilliSeconds(35)),
+                          false,
+                          "UE must sleep after its offset onDuration");
+
+    Simulator::Schedule(MilliSeconds(10), [this, ue]() {
+        NS_TEST_ASSERT_MSG_EQ(ue->GetCurrentState(),
+                              NR_UE_DEEP_SLEEP,
+                              "Energy model must sleep before the offset onDuration");
+    });
+    Simulator::Schedule(MilliSeconds(25), [this, ue]() {
+        NS_TEST_ASSERT_MSG_EQ(ue->GetCurrentState(),
+                              NR_UE_PDCCH_ONLY,
+                              "Energy model must wake at the offset onDuration");
+    });
+    Simulator::Schedule(MilliSeconds(35), [this, ue]() {
+        NS_TEST_ASSERT_MSG_EQ(ue->GetCurrentState(),
+                              NR_UE_DEEP_SLEEP,
+                              "Energy model must sleep after the offset onDuration");
+    });
+
+    Simulator::Stop(MilliSeconds(40));
+    Simulator::Run();
+    Simulator::Destroy();
+}
