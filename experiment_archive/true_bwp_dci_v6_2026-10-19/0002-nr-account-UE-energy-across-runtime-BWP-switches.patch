+    /**
+     * @brief Install one UE energy model per device and observe every BWP PHY.
+     *
+     * This overload supports runtime BWP switching without creating multiple
+     * energy models for one UE.  @p initialBwpIndex is subscribed last so its
+     * bandwidth scaling represents the primary BWP before the first TB.
+     *
+     * @param ueDevs UE NetDevices from NrHelper::InstallUeDevice.
+     * @param sources One energy::EnergySource per UE node, index-aligned.
+     * @param initialBwpIndex Primary BWP when energy accounting starts.
+     * @return Container of the created UE device energy models.
+     */
+    energy::DeviceEnergyModelContainer InstallUeAllBwps(
+        NetDeviceContainer ueDevs,
+        energy::EnergySourceContainer sources,
+        uint32_t initialBwpIndex = 0);
+
     /**
      * @brief Install both sides in one call.
      *
