+Time
+NrUeDrxModel::GetStartOffset() const
+{
+    return m_startOffset;
+}
+
+Time
+NrUeDrxModel::GetInactivityTimer() const
+{
+    return m_inactivityTimer;
+}
+
+bool
+NrUeDrxModel::IsActiveAt(Time time) const
+{
+    if (!m_started || time < m_startTime)
+    {
+        return false;
+    }
+
+    const int64_t cycleNs = m_longCycle.GetNanoSeconds();
+    NS_ABORT_MSG_IF(cycleNs <= 0, "DRX long cycle must be positive");
+    int64_t phaseNs = (time - m_startTime).GetNanoSeconds() % cycleNs;
+    if (phaseNs < 0)
+    {
+        phaseNs += cycleNs;
+    }
+    const bool inOnDuration = phaseNs < m_onDuration.GetNanoSeconds();
+    const bool inInactivity = m_inactivityRunning && time < m_inactivityEndTime;
+    return inOnDuration || inInactivity;
+}
