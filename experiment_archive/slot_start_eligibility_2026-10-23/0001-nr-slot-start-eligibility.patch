     NS_LOG_FUNCTION(this << startAt);
+    NS_ABORT_MSG_IF(startAt < Simulator::Now(), "DRX start time cannot be in the past");
     ApplyReferenceConfig();
+    NS_ABORT_MSG_IF(m_startOffset >= m_longCycle,
+                    "DRX StartOffset must be smaller than LongCycle");
+    m_startTime = startAt;
+    m_started = true;
+    m_nextCycleTime = startAt;
+    if (startAt > Simulator::Now())
+    {
+        GoToSleep();
+    }
     m_cycleEvent = Simulator::Schedule(startAt - Simulator::Now(), &NrUeDrxModel::StartCycle, this);
