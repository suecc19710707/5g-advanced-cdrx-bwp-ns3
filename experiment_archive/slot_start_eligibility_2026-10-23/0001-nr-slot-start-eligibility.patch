+void
+NrMacSchedulerNs3::ConfigureCellDtx(Time period, Time activeWindow, Time startOffset)
+{
+    NS_ABORT_MSG_IF(period <= Seconds(0), "Cell-DTX period must be positive");
+    NS_ABORT_MSG_IF(activeWindow < Seconds(0) || activeWindow > period,
+                    "Cell-DTX active window must be inside [0, period]");
+    m_cellDtxPeriod = period;
+    m_cellDtxActiveWindow = activeWindow;
+    m_cellDtxStartOffset = startOffset;
+    m_cellDtxEnabled = activeWindow < period;
+}
+
+void
+NrMacSchedulerNs3::DisableCellDtx()
+{
+    m_cellDtxEnabled = false;
+}
+
+bool
+NrMacSchedulerNs3::IsCellDtxSlotEligible(const SfnSf& targetSlot) const
+{
+    if (!m_cellDtxEnabled)
+    {
+        return true;
+    }
+
+    const int64_t periodNs = m_cellDtxPeriod.GetNanoSeconds();
+    const double slotsPerSecond = 1000.0 * (1u << targetSlot.GetNumerology());
+    const int64_t targetNs =
+        Seconds(static_cast<double>(targetSlot.Normalize()) / slotsPerSecond).GetNanoSeconds();
+    int64_t phaseNs = (targetNs - m_cellDtxStartOffset.GetNanoSeconds()) % periodNs;
+    if (phaseNs < 0)
+    {
+        phaseNs += periodNs;
+    }
+    return phaseNs < m_cellDtxActiveWindow.GetNanoSeconds();
+}
+
+void
+NrMacSchedulerNs3::SetUeDlEligibilityCallback(
+    std::function<bool(uint16_t, Time)> callback)
+{
+    m_ueDlEligibilityCallback = std::move(callback);
+}
+
+bool
+NrMacSchedulerNs3::IsUeDlEligible(uint16_t rnti, const SfnSf& targetSlot) const
+{
+    if (!m_ueDlEligibilityCallback)
+    {
+        return true;
+    }
+    const double slotsPerSecond = 1000.0 * (1u << targetSlot.GetNumerology());
+    const Time targetTime =
+        Seconds(static_cast<double>(targetSlot.Normalize()) / slotsPerSecond);
+    return m_ueDlEligibilityCallback(rnti, targetTime);
+}
