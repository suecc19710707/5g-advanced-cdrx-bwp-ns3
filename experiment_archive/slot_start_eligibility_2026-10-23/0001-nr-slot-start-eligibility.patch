+std::vector<NrMacSchedulerNs3::DlBearerBufferStats>
+NrMacSchedulerNs3::GetDlBearerBufferStats() const
+{
+    std::vector<DlBearerBufferStats> result;
+    for (const auto& [rnti, ue] : m_ueMap)
+    {
+        const auto& dlLcg = NrMacSchedulerUeInfo::GetDlLCG(ue);
+        for (const auto& [lcgId, lcg] : dlLcg)
+        {
+            (void)lcgId;
+            for (uint8_t lcid : lcg->GetLCId())
+            {
+                if (lcg->GetTotalSizeOfLC(lcid) == 0)
+                {
+                    continue;
+                }
+                const auto& lc = lcg->GetLC(lcid);
+                result.push_back({rnti,
+                                  lcid,
+                                  lc->m_rlcTransmissionQueueSize,
+                                  lc->m_rlcRetransmissionQueueSize,
+                                  lc->m_rlcStatusPduSize});
+            }
+        }
+    }
+    return result;
+}
+
+uint32_t
+NrMacSchedulerNs3::GetDlBearerCount() const
+{
+    uint32_t count = 0;
+    for (const auto& [rnti, ue] : m_ueMap)
+    {
+        const auto& dlLcg = NrMacSchedulerUeInfo::GetDlLCG(ue);
+        for (const auto& [lcgId, lcg] : dlLcg)
+        {
+            (void)lcgId;
+            count += static_cast<uint32_t>(lcg->GetLCId().size());
+        }
+    }
+    return count;
+}
