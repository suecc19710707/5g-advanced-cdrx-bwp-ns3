+void
+NrEnergyHelper::AttachGnbListener(Ptr<NetDevice> dev,
+                                  uint32_t bwpIndex,
+                                  Ptr<NrGnbEnergyModel> model)
+{
+    NS_LOG_FUNCTION(this << bwpIndex);
